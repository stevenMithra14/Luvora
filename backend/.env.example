APP_NAME="Luvora API"
APP_ENV=development
PORT=8000
DEBUG=True
SECRET_KEY="luvora-production-secret-change-this-key"

# Database Configuration (PostgreSQL default, SQLite fallback supported)
DATABASE_URL=sqlite:///./luvora_dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/luvora_db

# Storage Abstraction Configuration (local, cloudinary, supabase)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
